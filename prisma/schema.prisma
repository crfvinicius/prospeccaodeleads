generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum KanbanStage {
  NOVO
  CONTATADO
  RESPONDEU
  NEGOCIANDO
  FECHADO
  PERDIDO
}

enum LeadOrigem {
  GOOGLE_PLACES
  UPLOAD_XLSX
  UPLOAD_MARKDOWN
  MANUAL
}

enum MessageDirection {
  ENVIADA
  RECEBIDA
}

enum MessageStatus {
  PENDENTE
  ENVIADA
  ENTREGUE
  LIDA
  FALHOU
}

model SearchQuery {
  id             String   @id @default(cuid())
  localidade     String
  nicho          String
  quantidade     Int
  avaliacaoMinima Float?
  somenteComSite     Boolean?
  somenteComWhatsapp Boolean?
  createdAt      DateTime @default(now())

  leads Lead[]
}

model Lead {
  id              String      @id @default(cuid())
  nome            String
  telefone        String?
  whatsapp        String?
  endereco        String?
  localidade      String?
  nicho           String?
  avaliacaoGoogle Float?
  totalAvaliacoes Int?
  site            String?
  temSite         Boolean     @default(false)
  temWhatsapp     Boolean     @default(false)
  origem          LeadOrigem  @default(MANUAL)
  estagio         KanbanStage @default(NOVO)
  googlePlaceId   String?     @unique
  observacoes     String?

  searchQueryId String?
  searchQuery   SearchQuery? @relation(fields: [searchQueryId], references: [id])

  mensagens Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estagio])
  @@index([localidade])
  @@index([nicho])
}

model Message {
  id        String            @id @default(cuid())
  leadId    String
  lead      Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  direcao   MessageDirection
  conteudo  String
  status    MessageStatus     @default(PENDENTE)
  createdAt DateTime          @default(now())

  @@index([leadId])
}
