{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prospeccaodeleads",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-24",
  "containers": [
    {
      "class_name": "AppContainer",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "AppContainer",
        "name": "APP_CONTAINER"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["AppContainer"],
      "tag": "v1"
    }
  ],
  "vars": {
    "WHATSAPP_SESSION_DIR": "./.whatsapp-session"
  },
  "observability": {
    "enabled": true
  }
}
